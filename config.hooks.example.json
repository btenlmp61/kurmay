{
  "provider": "anthropic",
  "baseUrl": "",
  "apiKey": "",
  "model": "",
  "modelsUrl": "",
  "targetDir": "D:\\work\\testapp",
  "mcpServers": {},

  "workflow": {
    "entry": "analist",
    "maxCycles": 5,
    "agents": {
      "analist": {
        "file": ".claude/agents/analist.md",
        "tools": ["Read", "Glob", "Grep"],
        "requiresUserApproval": true,
        "routes": {
          "field": "route",
          "cases": { "implement": "saha", "done": null },
          "default": "saha"
        }
      },
      "saha": {
        "file": ".claude/agents/saha.md",
        "tools": ["Read", "Write", "Edit", "Glob", "Grep", "Bash"],
        "rules": ["genel"],
        "skills": ["test-yazimi"],
        "hooks": [
          { "event": "PreToolUse", "matcher": "Bash", "command": "node .claude/hooks/guard-bash.js" }
        ],
        "next": "teftis"
      },
      "teftis": {
        "file": ".claude/agents/teftis.md",
        "tools": ["Read", "Glob", "Grep", "Bash"],
        "rules": ["genel"],
        "hooks": [
          { "event": "PreToolUse", "matcher": "Bash", "command": "node .claude/hooks/guard-bash.js" }
        ],
        "verdict": { "onApprove": null, "onReject": "saha" }
      }
    }
  }
}
