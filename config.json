{
  "provider": "anthropic",
  "baseUrl": "",
  "apiKey": "",
  "model": "",
  "modelsUrl": "",
  "targetDir": "D:\\work\\testapp",
  "limits": {
    "structuredOutputRetries": 2,
    "apiTimeoutMs": 1800000
  },
  "retry": {
    "enabled": true,
    "maxAttempts": 0,
    "initialDelayMs": 5000,
    "maxDelayMs": 60000
  },
  "mcpServers": {
    "jetbrains-index-mcp-server": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "jetbrains-index-mcp-server"
      ]
    }
  },
  "workflow": {
    "entry": "architect",
    "maxCycles": 5,
    "agents": {
      "architect": {
        "file": ".claude/agents/architect.md",
        "tools": [
          "Read",
          "Glob",
          "Grep",
          "mcp__jetbrains-index-mcp-server"
        ],
        "rules": [
          "arama"
        ],
        "hooks": [
          {
            "event": "PreToolUse",
            "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
            "command": "node D:/work/yaver/.claude/hooks/guard-readonly.js"
          }
        ],
        "requiresUserApproval": true,
        "routes": {
          "field": "route",
          "cases": {
            "developer": "developer-team",
            "done": null
          },
          "default": "developer-team"
        }
      },
      "developer-team": {
        "type": "fanout",
        "agent": "developer",
        "maxConcurrency": 3,
        "next": "reviewer"
      },
      "developer": {
        "file": ".claude/agents/developer.md",
        "tools": [
          "Read",
          "Write",
          "Edit",
          "Glob",
          "Grep",
          "Bash",
          "mcp__jetbrains-index-mcp-server"
        ],
        "rules": [
          "genel",
          "arama"
        ],
        "skills": [
          "test-yazimi"
        ]
      },
      "reviewer": {
        "file": ".claude/agents/reviewer.md",
        "tools": [
          "Read",
          "Glob",
          "Grep",
          "Bash",
          "mcp__jetbrains-index-mcp-server"
        ],
        "rules": [
          "genel",
          "arama"
        ],
        "verdict": {
          "onApprove": null,
          "onReject": "developer-team"
        }
      }
    }
  }
}
