{
  "provider": "anthropic",
  "baseUrl": "",
  "apiKey": "",
  "model": "",
  "verdictModel": "",
  "targetDir": "D:\\work\\testapp",
  "limits": {
    "structuredOutputRetries": 2,
    "apiTimeoutMs": 1800000
  },
  "retry": {
    "enabled": true,
    "maxAttempts": 0,
    "initialDelayMs": 5000,
    "maxDelayMs": 60000
  },
  "mcpServers": {
    "jetbrains-index-mcp-server": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "jetbrains-index-mcp-server"
      ]
    }
  },
  "workflow": {
    "entry": "architect",
    "maxCycles": 5,
    "agents": {
      "architect": {
        "file": ".claude/agents/architect.md",
        "tools": [
          "Read",
          "Glob",
          "Grep",
          "mcp__jetbrains-index-mcp-server"
        ],
        "rules": [
          "arama"
        ],
        "hooks": [
          {
            "event": "PreToolUse",
            "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
            "command": "node D:/work/yaver/.claude/hooks/guard-readonly.js"
          }
        ],
        "requiresUserApproval": true,
        "routes": {
          "field": "route",
          "cases": {
            "developer": "developer",
            "done": null
          },
          "default": "developer"
        }
      },
      "developer": {
        "file": ".claude/agents/developer.md",
        "tools": [
          "Read",
          "Write",
          "Edit",
          "Glob",
          "Grep",
          "Bash",
          "mcp__jetbrains-index-mcp-server"
        ],
        "rules": [
          "genel",
          "arama"
        ],
        "skills": [
          "test-yazimi"
        ],
        "next": "review"
      },
      "review": {
        "type": "parallel",
        "branches": [
          "security",
          "tests",
          "style"
        ],
        "onApprove": "stage",
        "onReject": "developer"
      },
      "security": {
        "file": ".claude/agents/security.md",
        "tools": [
          "Read",
          "Glob",
          "Grep",
          "mcp__jetbrains-index-mcp-server"
        ],
        "rules": [
          "genel",
          "arama"
        ],
        "effort": "high"
      },
      "tests": {
        "file": ".claude/agents/tests.md",
        "tools": [
          "Read",
          "Glob",
          "Grep",
          "Bash",
          "mcp__jetbrains-index-mcp-server"
        ],
        "rules": [
          "genel",
          "arama"
        ],
        "effort": "medium",
        "hooks": [
          {
            "event": "PreToolUse",
            "matcher": "Bash",
            "command": "node D:/work/yaver/.claude/hooks/guard-readonly.js"
          }
        ]
      },
      "style": {
        "file": ".claude/agents/style.md",
        "tools": [
          "Read",
          "Glob",
          "Grep",
          "mcp__jetbrains-index-mcp-server"
        ],
        "rules": [
          "genel",
          "arama"
        ],
        "effort": "low"
      },
      "stage": {
        "type": "command",
        "command": "git add -A",
        "onSuccess": null,
        "onFailure": "developer"
      }
    }
  }
}