{
  "provider": "anthropic",
  "baseUrl": "",
  "apiKey": "",
  "model": "",
  "modelsUrl": "",
  "targetDir": "D:\\work\\testapp",
  "limits": {
    "structuredOutputRetries": 2,
    "apiTimeoutMs": 1800000
  },
  "retry": {
    "enabled": true,
    "maxAttempts": 0,
    "initialDelayMs": 5000,
    "maxDelayMs": 60000
  },
  "mcpServers": {
    "jetbrains-index-mcp-server": {
      "command": "cmd",
      "args": [
        "/c",
        "npx",
        "-y",
        "jetbrains-index-mcp-server"
      ]
    }
  },
  "workflow": {
    "entry": "analist",
    "maxCycles": 5,
    "agents": {
      "analist": {
        "file": ".claude/agents/analist.md",
        "tools": [
          "Read",
          "Glob",
          "Grep",
          "mcp__jetbrains-index-mcp-server"
        ],
        "rules": [
          "arama"
        ],
        "hooks": [
          {
            "event": "PreToolUse",
            "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
            "command": "node D:/work/yaver/.claude/hooks/guard-readonly.js"
          }
        ],
        "requiresUserApproval": true,
        "routes": {
          "field": "route",
          "cases": {
            "implement": "saha-timi",
            "done": null
          },
          "default": "saha-timi"
        }
      },
      "saha-timi": {
        "type": "fanout",
        "agent": "saha",
        "maxConcurrency": 3,
        "next": "teftis"
      },
      "saha": {
        "file": ".claude/agents/saha.md",
        "tools": [
          "Read",
          "Write",
          "Edit",
          "Glob",
          "Grep",
          "Bash",
          "mcp__jetbrains-index-mcp-server"
        ],
        "rules": [
          "genel",
          "arama"
        ],
        "skills": [
          "test-yazimi"
        ]
      },
      "teftis": {
        "file": ".claude/agents/teftis.md",
        "tools": [
          "Read",
          "Glob",
          "Grep",
          "Bash",
          "mcp__jetbrains-index-mcp-server"
        ],
        "rules": [
          "genel",
          "arama"
        ],
        "verdict": {
          "onApprove": "cekme-istegi",
          "onReject": "saha-timi"
        }
      },
      "cekme-istegi": {
        "type": "pr",
        "disabled": true,
        "next": null
      }
    }
  }
}
