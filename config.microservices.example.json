{
  "provider": "anthropic",
  "baseUrl": "",
  "apiKey": "",
  "model": "",
  "modelsUrl": "",
  "targetDir": "D:\\work\\platform",
  "mcpServers": {},

  "workflow": {
    "entry": "analist",
    "maxCycles": 5,

    "agents": {
      "analist": {
        "file": ".claude/agents/analist.md",
        "tools": ["Read", "Glob", "Grep"],
        "requiresUserApproval": true,
        "routes": {
          "field": "route",
          "cases": { "implement": "saha", "done": null },
          "default": "saha"
        }
      },
      "saha": {
        "file": ".claude/agents/saha.md",
        "tools": ["Read", "Write", "Edit", "Glob", "Grep", "Bash"],
        "rules": ["genel"],
        "skills": ["test-yazimi"],
        "next": "build"
      },
      "build": {
        "type": "command",
        "command": "mvn clean install -q",
        "parent": { "path": "common-events", "command": "mvn clean install" },
        "onSuccess": "teftis",
        "onFailure": "saha"
      },
      "teftis": {
        "file": ".claude/agents/teftis.md",
        "tools": ["Read", "Glob", "Grep", "Bash"],
        "rules": ["genel"],
        "verdict": { "onApprove": null, "onReject": "saha" }
      }
    }
  }
}
